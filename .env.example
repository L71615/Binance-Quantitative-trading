BINANCE_TESTNET=true
# Do NOT commit real keys. Use the UI Setup wizard to store them.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- LLM (OpenAI-compatible: DeepSeek, OpenAI, Moonshot, ...) ---
# Leave LLM_API_KEY blank to disable AI features; the API will report
# "LLM not configured" instead of attempting a call.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
